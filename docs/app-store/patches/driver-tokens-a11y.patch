@@ -42,7 +42,12 @@
   /* Typography */
   --text-primary: #f5f5f7;
   --text-secondary: #a0a8b8;
-  --text-muted: #6b7280;
+  /* Bumped from #6b7280 → #9ca3af for WCAG AA contrast (≥4.5:1)
+     against `--bg-card` (rgba(26,32,42,0.9)) — the old value
+     measured ~4.0:1 against card surfaces and failed AA for
+     small body text. New value measures ~6.3:1 on bg-deep and
