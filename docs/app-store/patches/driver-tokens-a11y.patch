+  --text-muted: #9ca3af;
 
   /* Bronze / copper — engine-metal accent */
   --accent-gold: #c9a227;
@@ -136,6 +141,30 @@
 
 html { scroll-behavior: smooth; }
 
+/* ---------- Accessibility: keyboard focus ---------- */
+/* A clear, high-contrast focus ring for all interactive controls
+   (buttons, links, inputs). Uses :focus-visible so mouse clicks
+   don't trigger a ring but Tab / VoiceOver navigation does. */
+:focus-visible {
+  outline: 2px solid var(--accent-gold);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+/* ---------- Accessibility: reduced motion ---------- */
+/* Honor the user's OS-level "reduce motion" setting. Disables
+   the smooth-scroll, theme transitions, and most micro-animations
+   while keeping the UI fully functional. */
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after {
+    animation-duration: 0.001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
