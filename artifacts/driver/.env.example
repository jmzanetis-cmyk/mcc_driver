# ============================================================
# MCC Driver — Build-time env (Vite)
# ============================================================
# Copy to `.env.local` for local dev overrides, or set in the
# build environment for CI / iOS / production. Vite only inlines
# `VITE_*` vars into the client bundle.
# ============================================================

# Supabase project (REQUIRED — auth + realtime).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API base origin.
#   - Web / Replit dev preview: leave UNSET so the app uses
#     relative `/api/*` URLs (served by the shared reverse proxy).
#   - Native iOS (Capacitor) production build: MUST be set to the
#     deployed API origin, e.g. `https://api.mycarconcierge.com`.
#     The `/api` prefix is appended automatically by `apiUrl()`.
#   - Native iOS staging / TestFlight: set to the staging origin.
VITE_API_BASE_URL=

# Active environment label. Drives the "STAGING" / "DEV" badge
# rendered in non-production builds so QA never confuses a
# staging device for a prod one. Recognized values:
#   production | staging | development
# Defaults to production when Vite is built in --mode production.
VITE_APP_ENV=

# Google Maps JavaScript API key (OPTIONAL — map views degrade gracefully
# when unset, showing a loading state instead of the live map).
# Obtain from console.cloud.google.com → APIs & Services → Credentials.
# Restrict the key to the Maps JavaScript API and your allowed origins.
VITE_GOOGLE_MAPS_API_KEY=

# Sentry (OPTIONAL — leave unset to disable telemetry).
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=
# VITE_SENTRY_RELEASE — auto-computed from pkg version + git sha; override only if needed.
VITE_SENTRY_RELEASE=
