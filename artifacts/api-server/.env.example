# ============================================================
# MCC API Server — Runtime env
# ============================================================
# Copy to `.env` for local dev. In production, set these as
# secrets in your deployment environment (Replit Secrets, etc.).
# ============================================================

# ── Server ───────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Supabase ─────────────────────────────────────────────────

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Stripe ───────────────────────────────────────────────────

STRIPE_SECRET_KEY=
# Signing secret from the Stripe Dashboard → Webhooks endpoint.
# Required for POST /api/stripe/webhook signature verification.
STRIPE_WEBHOOK_SECRET=

# Redirect target after Stripe Connect onboarding completes.
DRIVER_APP_URL=

# ── Anthropic ────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# ── Internal API key ─────────────────────────────────────────
# Protects dispatch-only routes (POST /api/payouts/run-weekly,
# POST /api/rides/dispatch). Set a long random secret.

DISPATCH_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────

RESEND_API_KEY=
DRIVER_EMAIL_FROM=
DRIVER_SIGN_IN_URL=

# ── SMS (Twilio) ─────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Push notifications ───────────────────────────────────────

# APNs (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
# Set to "true" for production APNs gateway; omit or "false" for sandbox.
APNS_PRODUCTION=false

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Base URL used to build deep-link URLs in push notification payloads.
APP_BASE_URL=

# ── Sentry ───────────────────────────────────────────────────

SENTRY_DSN=
SENTRY_ENV=
SENTRY_RELEASE=

# ── Replit ───────────────────────────────────────────────────
# Injected automatically on Replit; used to build allowed-origin
# lists for email / notification callbacks. Leave unset locally.

REPLIT_DOMAINS=

# ── Deprecated ───────────────────────────────────────────────
# Legacy fallback for admin auth; superseded by the admin_users
# DB table. Remove once all admin accounts are migrated.

ADMIN_EMAILS=
